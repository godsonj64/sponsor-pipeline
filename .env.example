# ---------------------------------------------------------------------------
# Local development — nothing here is required.
# ---------------------------------------------------------------------------
# Full path to the pipeline's SQLite database. Defaults to ../resumes/sponsors.db,
# so with the standard layout you can leave this alone.
# SPONSORS_DB=/Users/you/Downloads/resumes/sponsors.db

# ---------------------------------------------------------------------------
# Hosted deployment (Vercel) — all three are required.
# ---------------------------------------------------------------------------
# Postgres connection string. Its presence is what switches the app off SQLite.
# Attach Neon or Vercel Postgres from the Storage tab and this is set for you.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# The password that unlocks the app. Without it the app is UNPROTECTED, which is
# fine on localhost and unacceptable on a public URL.
# SPONSOR_PASSWORD=

# Signs the session cookie. Generate one with: openssl rand -base64 32
# SESSION_SECRET=

# Optional: pin the Postgres pool size (default 3).
# PG_POOL_MAX=3
